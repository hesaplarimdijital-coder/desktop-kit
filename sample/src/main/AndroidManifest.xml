<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- enableOnBackInvokedCallback: the predictive Back gesture (Android 14+) plays the kit's screen transitions -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_sample"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sample">
        <!-- resizeableActivity and configChanges let DeX resize the window without restarting the activity,
             so the shell keeps its state when the window crosses width classes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The window a desktop (DeX, desktop windowing) opens it in, and the smallest it may be made:
                 386 x 352 dp is Android's own minimum for a desktop window, which the kit's layouts are tested at -->
            <layout
                android:defaultWidth="1100dp"
                android:defaultHeight="720dp"
                android:gravity="center"
                android:minWidth="386dp"
                android:minHeight="352dp" />
            <!-- Android 15+: the system's window menus (DeX, desktop windowing, the taskbar) offer "New window" -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>
    </application>
</manifest>
