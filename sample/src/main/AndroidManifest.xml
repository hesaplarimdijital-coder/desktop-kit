<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- enableOnBackInvokedCallback: the predictive Back gesture (Android 14+) plays the kit's screen transitions -->
    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_sample"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sample">
        <!-- resizeableActivity and configChanges let DeX resize the window without restarting the activity,
             so the shell keeps its state when the window crosses width classes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
